{
  "name": "self-healing-tool",
  "version": "0.1.0",
  "private": true,
  "description": "Bounded Playwright locator recovery with inspectable outcomes.",
  "license": "MIT",
  "engines": {
    "node": ">=22 <26"
  },
  "scripts": {
    "spec:validate": "openspec validate --all --strict --no-interactive",
    "spec:list": "openspec list --json",
    "audit:check": "node scripts/check-traceability.mjs",
    "check": "npm run spec:validate && npm run audit:check",
    "test": "npm run check && npm run format:check && npm run test:audit && npm run typecheck && npm run test:unit && npm run test:browser && npm run test:presentation && npm run test:consumer && npm run test:lifecycle",
    "test:audit": "node --test scripts/check-traceability.test.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write \"src/**/*.{ts,js}\" \"presentation/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,js}\" \"presentation/*.mjs\"",
    "test:unit": "npm run build && node --test tests/*.test.mjs",
    "test:browser": "npm run build && playwright test",
    "test:consumer": "npm run build && node scripts/check-consumer.mjs",
    "demo:offline": "npm run build && node examples/local-demo/run.mjs",
    "demo:live": "npm run build && node --env-file=.env examples/local-demo/run.mjs --live",
    "prepare": "npm run build",
    "demo": "npm run build && node presentation/cli.mjs",
    "demo:report": "node presentation/cli.mjs",
    "demo:walkthrough": "npm run build && node presentation/cli.mjs --walkthrough",
    "demo:live:compare": "npm run build && node presentation/cli.mjs --walkthrough --live",
    "test:presentation": "npm run build && node --test presentation/*.test.mjs",
    "test:lifecycle": "npm run build && node scripts/check-playwright-consumer.mjs"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.12.0",
    "@playwright/test": "1.62.1",
    "@types/node": "24.0.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "import": "./dist/playwright.js",
      "default": "./dist/playwright.js"
    },
    "./reporter": {
      "types": "./dist/reporter.d.ts",
      "import": "./dist/reporter.js",
      "default": "./dist/reporter.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs/integration.md",
    "docs/implementation/component-inventory.md",
    "docs/implementation/thesis-method-alignment.md",
    "docs/playwright.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSES"
  ],
  "peerDependencies": {
    "@playwright/test": ">=1.62.1 <2",
    "playwright": ">=1.62.1 <2"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wildanniam/self-healing-tool.git"
  },
  "homepage": "https://github.com/wildanniam/self-healing-tool#readme",
  "bugs": {
    "url": "https://github.com/wildanniam/self-healing-tool/issues"
  }
}
