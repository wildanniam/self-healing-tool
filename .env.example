# Copy to .env only if you do not already have a local .env.
# Enter your own key in .env. Never commit or share it.
# Optional live-provider settings. Load this file explicitly; the library does not auto-load .env.
# See docs/playwright.md for full-mode setup. Offline examples need no API key.
OPENAI_API_KEY=

OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0
HEALING_MAX_RETRIES=3
HEALING_DOM_MAX_CHARS=8000
