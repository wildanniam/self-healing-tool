# Copy to .env only if you do not already have a local .env.
# Enter your own key in .env. Never commit or share it.
# These are initial reference settings; the runtime loader is not implemented yet.
OPENAI_API_KEY=

OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0
HEALING_MAX_RETRIES=3
HEALING_DOM_MAX_CHARS=8000
